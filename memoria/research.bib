@misc{MemoriaTFG,
year = {2025},
month = {2},
url = {https://hdl.handle.net/10481/102499},
abstract = {Los autores de este libro somos profesores y profesoras de informática y llevamos mucho tiempo tiempo
tutorizando estudiantes y evaluando TFG. En este tiempo, hemos visto que la tarea que más os cuesta es la escritura de la memoria del TFG. Es por ello que hemos desarrolladoo este manual, en el que nos enfocamos en guiarte a través del proceso de elaborar con éxito una memoria de TFG.

Para facilitar este proceso, hemos acompañado este texto con una serie de vídeos cortos de cada capítulo con el objetivo de ofrecer las ideas principales de los mismos en un formato complementario y resumido al libro.

Pretendemos que este texto sea un documento vivo, en el que todos los miembros de la comunidad académica puedan participar de forma colaborativa en la mejora del mismo. Te invitamos a que hagas aportaciones al texto, detectando erratas, añadiendo cosas que se nos han pasado y que consideras importantes, proponiendo nuevos temas sobre los que hablar, etc.},
publisher = {Universidad de Granada},
keywords = {TFG},
keywords = {Trabajo fin de grado},
keywords = {Escritura de la memoria},
keywords = {Grado en Ingeniería Informática},
keywords = {Informática},
keywords = {Proyecto fin de carrera},
keywords = {Ciencias de la Computación},
title = {Cómo escribir la memoria de tu TFG del Grado en Ingeniería Informática y presentarlo sin morir en el intento},
doi = {10.5281/zenodo.14887022},
author = {Guillén Perales, Alberto and Martínez Cámara, Eugenio and Fernández Luna, Juan Manuel and García Sánchez, Pablo and Noguera García, Manuel and Rodríguez Fórtiz, María José and Romero Zaliz, Rocio Celeste},
}